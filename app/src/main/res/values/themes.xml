<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema claro con los colores corporativos de Tambo (también aplica en modo oscuro). -->
    <style name="Base.Theme.Tambo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tambo_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/tambo_yellow</item>
        <item name="colorOnSecondary">@color/tambo_text</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.Tambo" parent="Base.Theme.Tambo" />

    <style name="Tambo.Button.Yellow" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tambo_yellow</item>
        <item name="android:textColor">@color/tambo_text</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Tambo.Button.Purple" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tambo_purple</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
